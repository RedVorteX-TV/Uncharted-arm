#!/bin/sh
# AppImage entry point: the launcher, with its writable data outside the read-only image.
here=$(dirname "$(readlink -f "$0")")

# The package needs the glibc it was built with or newer (GLIBC_REQUIRED, written by package.sh:
# 2.38 for the x86-64 build on Debian 13; the ARM build's Fedora release for aarch64). On an
# older system say so instead of a loader error.
required=$(cat "$here/GLIBC_REQUIRED" 2>/dev/null || echo 2.38)
glibc=$(getconf GNU_LIBC_VERSION 2>/dev/null | awk '{print $2}')
if [ -n "$glibc" ] && [ "$(printf '%s\n%s\n' "$glibc" "$required" | sort -V | head -1)" != "$required" ]; then
    message="Uncharted needs a newer Linux system (glibc $required or later; this one has $glibc)."
    echo "$message" >&2
    if command -v zenity >/dev/null 2>&1; then zenity --error --title=Uncharted --text="$message" 2>/dev/null
    elif command -v kdialog >/dev/null 2>&1; then kdialog --title Uncharted --error "$message" 2>/dev/null
    fi
    exit 1
fi

export BB_DATA_DIR="${BB_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/uncharted-linux}"
mkdir -p "$BB_DATA_DIR"
exec "$here/Uncharted" "$@"
