<?xml version="1.0" encoding="utf-8"?>
<!-- Uncharted: The Nathan Drake Collection for Android (ARM port by RedVorteX-TV), on ducvd89's
     Bloodborne-Android runtime. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.redvortextv.uncharted" android:versionCode="2" android:versionName="0.1.1">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="28" />
    <!-- GPU driver downloads (the driver list on GitHub). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The game folder in shared storage (targetSdk 28: file paths, as the game process reads them). -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <application android:label="Uncharted" android:icon="@drawable/icon"
        android:theme="@style/GameTheme" android:debuggable="true"
        android:allowBackup="false" android:extractNativeLibs="true" android:isGame="true" android:appCategory="game"
        android:requestLegacyExternalStorage="true"
        android:allowAudioPlaybackCapture="true">
        <meta-data android:name="android.game_mode_config" android:resource="@xml/game_mode_config" />
        <activity android:name="com.redvortextv.uncharted.MainActivity" android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
